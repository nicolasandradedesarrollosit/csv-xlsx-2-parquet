---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Alert from '../ui/Alert.astro';
import Dropzone from '../ui/Dropzone.astro';
import FileBar from '../ui/FileBar.astro';
import Hero from '../ui/Hero.astro';
import Status from '../ui/Status.astro';
import { SITE } from '../../config/site';
---

<BaseLayout seo={{ title: SITE.title, description: SITE.description }}>
  <Hero />
  <section class="wrap mt-10" aria-label="Converter" data-converter>
    <Dropzone />
    <Status />
    <Alert />
    <div class="mt-8 grid gap-8" data-workspace hidden>
      <div class="card">
        <FileBar />
      </div>
    </div>
  </section>
</BaseLayout>
