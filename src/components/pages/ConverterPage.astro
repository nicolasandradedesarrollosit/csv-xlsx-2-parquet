---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Alert from '../ui/Alert.astro';
import Dropzone from '../ui/Dropzone.astro';
import ExportBar from '../ui/ExportBar.astro';
import FileBar from '../ui/FileBar.astro';
import Hero from '../ui/Hero.astro';
import HowItWorks from '../ui/HowItWorks.astro';
import PreviewTable from '../ui/PreviewTable.astro';
import SchemaTable from '../ui/SchemaTable.astro';
import Stats from '../ui/Stats.astro';
import Status from '../ui/Status.astro';
import Guide from '../ui/Guide.astro';
import { PAGES, type PageKey } from '../../config/site';
import { GUIDES } from '../../data/guides';
import { webApplication } from '../../lib/seo';

interface Props {
  page: PageKey;
}

const { page } = Astro.props;
const { title, description } = PAGES[page];
---

<BaseLayout seo={{ title, description }} jsonLd={[webApplication(Astro.site, page)]}>
  <Hero {...GUIDES[page].hero} />
  <section class="wrap mt-10" aria-label="Converter" data-converter>
    <Dropzone />
    <Status />
    <Alert />
    <div class="mt-8 grid grid-cols-1 gap-8 *:min-w-0" data-workspace hidden>
      <div class="card">
        <FileBar />
      </div>
      <Stats />
      <SchemaTable />
      <ExportBar />
      <PreviewTable />
    </div>
  </section>
  <HowItWorks />
  <Guide page={page} />
</BaseLayout>
