---
interface Props {
  kicker: string;
  title: string;
  lead: string;
}
const { kicker, title, lead } = Astro.props;
---

<section class="wrap pt-12 sm:pt-16" aria-labelledby="hero-title">
  <p class="kicker">{kicker}</p>
  <h1 id="hero-title" class="mt-4 max-w-3xl text-display leading-[1.02] font-semibold tracking-tighter">
    {title}
  </h1>
  <p class="mt-5 max-w-2xl text-lg text-muted">
    {lead}
  </p>
</section>
