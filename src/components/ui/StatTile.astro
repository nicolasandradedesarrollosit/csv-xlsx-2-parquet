---
interface Props {
  stat: string;
  label: string;
}
const { stat, label } = Astro.props;
---

<div class="card flex flex-col gap-2 p-5" data-stat={stat}>
  <p class="label">{label}</p>
  <p class="text-2xl font-semibold tracking-tight tabular-nums" data-stat-value>—</p>
  <p class="font-mono text-xs text-muted" data-stat-note hidden></p>
</div>
