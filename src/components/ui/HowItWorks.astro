---
import SectionHeading from './SectionHeading.astro';
import { STEPS } from '../../data/faq';
---

<section class="wrap section" aria-labelledby="how-title">
  <SectionHeading id="how" kicker="/ how it works" title="Convert CSV or Excel to Parquet in three steps">
    No sign-up and no upload: the file is converted on your device.
  </SectionHeading>
  <ol role="list" class="grid gap-4 md:grid-cols-3">
    {
      STEPS.map((step, index) => (
        <li class="card">
          <p class="label">Step {index + 1}</p>
          <h3 class="mt-3 text-lg font-semibold">{step.title}</h3>
          <p class="mt-2 text-sm text-muted">{step.body}</p>
        </li>
      ))
    }
  </ol>
</section>
