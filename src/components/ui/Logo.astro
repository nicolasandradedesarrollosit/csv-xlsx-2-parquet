---
interface Props {
  class?: string;
}
const { class: className = 'w-7' } = Astro.props;
---

<svg class={className} viewBox="0 0 64 64" aria-hidden="true">
  <rect width="64" height="64" rx="14" fill="var(--fg)"></rect>
  <g fill="var(--bg)">
    <rect x="16" y="18" width="14" height="6" rx="2"></rect>
    <rect x="34" y="18" width="14" height="6" rx="2" opacity="0.55"></rect>
    <rect x="16" y="29" width="14" height="6" rx="2" opacity="0.55"></rect>
    <rect x="34" y="29" width="14" height="6" rx="2"></rect>
    <rect x="16" y="40" width="14" height="6" rx="2"></rect>
    <rect x="34" y="40" width="14" height="6" rx="2" opacity="0.55"></rect>
  </g>
</svg>
