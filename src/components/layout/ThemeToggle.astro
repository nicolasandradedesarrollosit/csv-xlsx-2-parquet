---
import Icon from '../ui/Icon.astro';

interface Props {
  label: string;
}
const { label } = Astro.props;
---

<button type="button" class="icon-btn" data-theme-toggle aria-label={label}>
  <span class="dark:hidden"><Icon name="moon" class="size-[1.05rem]" /></span>
  <span class="hidden dark:inline"><Icon name="sun" class="size-[1.05rem]" /></span>
</button>
